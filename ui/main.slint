struct Cell {
    is-mine: bool,
    is-revealed: bool,
    is-flagged: bool,
    neighbor-count: int,
}

export enum GameState { Playing, Won, Lost }

export component AppWindow inherits Window {
    title: "Minesweeper";
    
    callback cell-clicked(int, int);
    callback cell-flagged(int, int);
    callback cell-chorded(int, int);
    callback new-game(int);
    callback toggle-theme();
    callback open-bg-picker();
    callback clear-bg-image();

    in property <int>       cols: 9;
    in property <int>       rows: 9;
    in property <int>       mines-remaining: 10;
    in property <int>       elapsed-seconds: 0;
    in property <GameState> game-state: Playing;
    in property <[Cell]>    cells;
    in property <bool>      dark-mode: true;
    in property <image>     bg-image;
    in property <bool>      use-bg-image: false;

    min-width: 300px;
    min-height: 400px;

    // Base (1.0-zoom) size of one grid cell, in logical px. The grid's natural
    // size is cols*cell-base by rows*cell-base; everything else is sized to match.
    property <length> cell-base: 32px;

    // The UI's natural (zoom = 1.0) design size for the current difficulty.
    // 16px = horizontal padding; 98px = total vertical chrome (padding 16 +
    // header 42 + spacing 6 + toolbar 28 + spacing 6).
    property <length> ref-width:  cols * cell-base + 16px;
    property <length> ref-height: rows * cell-base + 98px;

    // Single scale factor for the WHOLE UI, derived live from the window size.
    // min() of the two axis ratios preserves aspect, so chrome + grid scale as
    // one block and track the drag in real time (no timer, no post-resize snap).
    //
    // This does NOT create a binding loop because the window's width/height no
    // longer depend on the content: the content block is sized explicitly from
    // `zoom` and merely centered inside a full-window Rectangle, so nothing
    // feeds child size info back up into root.width / root.height.
    property <float> zoom: max(0.4, min(root.width / ref-width, root.height / ref-height));

    // ── Palette ───────────────────────────────────────────────────────────────
    property <color> p-bg:      dark-mode ? #1e1e2e : #dfe3f0;
    property <color> p-surface: dark-mode ? #313244 : #c8cedf;
    property <color> p-overlay: dark-mode ? #45475a : #aeb5c9;
    property <color> p-muted:   dark-mode ? #585b70 : #8b92a8;
    property <color> p-text:    dark-mode ? #cdd6f4 : #1e2030;
    property <color> p-subtext: dark-mode ? #a6adc8 : #444860;
    property <color> p-green:   dark-mode ? #a6e3a1 : #2d6a30;
    property <color> p-red:     dark-mode ? #f38ba8 : #a01530;
    property <color> p-yellow:  dark-mode ? #f9e2af : #8c5e00;
    property <color> p-blue:    dark-mode ? #89b4fa : #1040a0;
    property <color> p-peach:   dark-mode ? #fab387 : #963800;
    property <color> p-teal:    dark-mode ? #94e2d5 : #0a5560;
    property <color> p-mauve:   dark-mode ? #cba6f7 : #5a1a8a;
    property <color> p-sky:     dark-mode ? #89dceb : #005a80;

    background: use-bg-image ? transparent : p-bg;
    animate background { duration: 180ms; }

    property <bool> settings-open: false;
    
    function neighbor-color(n: int) -> color {
        if n == 1 { return p-blue;   }
        if n == 2 { return p-green;  }
        if n == 3 { return p-red;    }
        if n == 4 { return p-mauve;  }
        if n == 5 { return p-peach;  }
        if n == 6 { return p-teal;   }
        if n == 7 { return p-sky;    }
        return p-text;
    }

    if use-bg-image : Image {
        source: bg-image;
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        image-fit: cover;
    }

    Rectangle {
        width: parent.width;
        height: parent.height;

        // The content block is sized to its natural (zoom-scaled) dimensions and
        // centered, so the whole UI scales as one unit rather than the grid
        // absorbing leftover space on its own.
        VerticalLayout {
            width: (root.cols * root.cell-base + 16px) * root.zoom;
            x: (parent.width - self.width) / 2;
            y: max(0px, (parent.height - self.height) / 2);
            padding: 8px * zoom;
            spacing: 6px * zoom;

            // ── Header ────────────────────────────────────────────────────────────
            Rectangle {
                height: 42px * zoom;
                border-radius: 8px * zoom;
                background: use-bg-image ? (dark-mode ? #1e1e2ed8 : #dfe3f0d8) : p-surface;
                animate background { duration: 180ms; }

                HorizontalLayout {
                    padding-left: 12px * zoom;
                    padding-right: 12px * zoom;
                    alignment: space-between;

                    Text {
                        text: "💣 " + mines-remaining;
                        color: p-red;
                        font-size: 16px * zoom; font-weight: 700;
                        vertical-alignment: center;
                        width: 65px * zoom;
                        height: 42px * zoom;
                    }

                    smiley-ta := TouchArea {
                        width: 40px * zoom;
                        height: 42px * zoom;
                        clicked => { new-game(rows == 9 ? 0 : (cols == 16 ? 1 : 2)); }
                        Text {
                            text: game-state == GameState.Won  ? "😎" :
                                  game-state == GameState.Lost ? "😵" : "😊";
                            font-size: 24px * zoom;
                            width: 100%; height: 100%;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "⏱ " + elapsed-seconds;
                        color: p-yellow;
                        font-size: 16px * zoom; font-weight: 700;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        width: 65px * zoom;
                        height: 42px * zoom;
                    }
                }
            }

            // ── Toolbar ───────────────────────────────────────────────────────────
            HorizontalLayout {
                spacing: 5px * zoom;
                alignment: center;
                height: 28px * zoom;

                Rectangle {
                    width: 58px * zoom; height: 28px * zoom; border-radius: 6px * zoom;
                    background: d0.has-hover ? p-overlay : (use-bg-image ? p-surface.with-alpha(0.85) : p-surface);
                    animate background { duration: 80ms; }
                    d0 := TouchArea { clicked => { new-game(0); } }
                    Text { text: "Easy"; color: p-text; font-size: 11px * zoom; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    width: 66px * zoom; height: 28px * zoom; border-radius: 6px * zoom;
                    background: d1.has-hover ? p-overlay : (use-bg-image ? p-surface.with-alpha(0.85) : p-surface);
                    animate background { duration: 80ms; }
                    d1 := TouchArea { clicked => { new-game(1); } }
                    Text { text: "Medium"; color: p-text; font-size: 11px * zoom; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                }
                Rectangle {
                    width: 58px * zoom; height: 28px * zoom; border-radius: 6px * zoom;
                    background: d2.has-hover ? p-overlay : (use-bg-image ? p-surface.with-alpha(0.85) : p-surface);
                    animate background { duration: 80ms; }
                    d2 := TouchArea { clicked => { new-game(2); } }
                    Text { text: "Hard"; color: p-text; font-size: 11px * zoom; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle { width: 8px * zoom; background: transparent; }

                gear-ta := TouchArea {
                    width: 28px * zoom; height: 28px * zoom;
                    clicked => { settings-open = !settings-open; }
                    Text {
                        text: "⚙";
                        color: settings-open ? p-yellow : p-subtext; font-size: 16px * zoom;
                        width: 100%; height: 100%; horizontal-alignment: center; vertical-alignment: center;
                    }
                }
            }

            // ── Settings panel ────────────────────────────────────────────────────
            if settings-open : Rectangle {
                height: 62px * zoom;
                border-radius: 8px * zoom;
                background: use-bg-image ? (dark-mode ? #1e1e2eee : #dfe3f0ee) : p-surface;
                animate background { duration: 180ms; }

                VerticalLayout {
                    padding: 8px * zoom; spacing: 6px * zoom;
                    Text {
                        text: "SETTINGS";
                        color: p-subtext; font-size: 9px * zoom; font-weight: 700; height: 12px * zoom;
                    }
                    HorizontalLayout {
                        spacing: 6px * zoom; alignment: start; height: 28px * zoom;
                        Rectangle {
                            width: 110px * zoom; height: 28px * zoom; border-radius: 6px * zoom;
                            background: th-ta.has-hover ? p-overlay : p-bg.with-alpha(0.6);
                            border-width: 1px * zoom; border-color: p-muted;
                            animate background { duration: 80ms; }
                            th-ta := TouchArea { clicked => { toggle-theme(); } }
                            HorizontalLayout {
                                padding-left: 7px * zoom; padding-right: 7px * zoom; spacing: 5px * zoom; alignment: center;
                                Text { text: dark-mode ? "☀" : "🌙"; font-size: 14px * zoom; height: 28px * zoom; vertical-alignment: center; }
                                Text { text: dark-mode ? "Light" : "Dark"; color: p-text; font-size: 11px * zoom; font-weight: 600; vertical-alignment: center; }
                            }
                        }
                        Rectangle {
                            width: 130px * zoom; height: 28px * zoom; border-radius: 6px * zoom;
                            background: bg-ta.has-hover ? p-overlay : p-bg.with-alpha(0.6);
                            border-width: 1px * zoom; border-color: p-muted;
                            animate background { duration: 80ms; }
                            bg-ta := TouchArea { clicked => { open-bg-picker(); } }
                            HorizontalLayout {
                                padding-left: 7px * zoom; padding-right: 7px * zoom; spacing: 5px * zoom; alignment: center;
                                Text { text: "📁"; font-size: 14px * zoom; height: 28px * zoom; vertical-alignment: center; }
                                Text { text: use-bg-image ? "Change bg" : "Set bg image"; color: p-text; font-size: 11px * zoom; font-weight: 600; vertical-alignment: center; }
                            }
                        }
                        if use-bg-image : Rectangle {
                            width: 28px * zoom; height: 28px * zoom;
                            clr-ta := TouchArea { clicked => { clear-bg-image(); } }
                            Text { 
                                text: "Clear"; color: clr-ta.has-hover ? p-red : p-subtext; 
                                font-size: 10px * zoom; font-weight: 700; 
                                width: 100%; height: 100%; 
                                horizontal-alignment: center; vertical-alignment: center; 
                            }
                        }
                    }
                }
            }

            // ── Win/Lose banner ───────────────────────────────────────────────────
            if game-state != GameState.Playing : Rectangle {
                height: 30px * zoom; border-radius: 7px * zoom;
                background: game-state == GameState.Won ? p-green.with-alpha(use-bg-image ? 0.45 : 0.18) : p-red.with-alpha(use-bg-image ? 0.45 : 0.18);
                Text {
                    text: game-state == GameState.Won ? "🎉  You win!  Click 😊 to play again." : "💥  Game over!  Click 😊 to play again.";
                    color: game-state == GameState.Won ? p-green : p-red;
                    font-size: 12px * zoom; font-weight: 700; height: 100%; horizontal-alignment: center; vertical-alignment: center;
                }
            }

            // ── Grid (scales in lockstep with the chrome) ──────────────────────────
            Rectangle {
                height: root.rows * root.cell-base * root.zoom;
                border-radius: 8px * zoom;
                background: use-bg-image ? (dark-mode ? #31324488 : #c8cedf88) : p-surface;
                clip: true;
                animate background { duration: 180ms; }

                for cell[idx] in cells : cell-item := Rectangle {
                    property <int> cell-col: mod(idx, cols);
                    property <int> cell-row: floor(idx / cols);
                    property <bool> left-down: false;
                    property <bool> right-down: false;
                    
                    x: (parent.width / cols) * self.cell-col;
                    y: (parent.height / rows) * self.cell-row;
                    width: parent.width / cols;
                    height: parent.height / rows;

                    border-radius: 4px * zoom;
                    // Lowered alpha layers to expose the background better
                    background:
                        (left-down && right-down)              ? p-yellow.with-alpha(0.75) :
                        !cell.is-revealed && cell-ta.has-hover ? p-muted.with-alpha(0.85) :
                        cell.is-revealed && cell.is-mine       ? p-red.with-alpha(0.65) :
                        cell.is-revealed                       ? p-bg.with-alpha(0.65) :
                        cell.is-flagged                        ? p-yellow.with-alpha(0.65) : p-overlay.with-alpha(0.85);
                    
                    border-width: 1px;
                    border-color:
                        cell.is-revealed && cell.is-mine ? p-red :
                        cell.is-revealed                 ? p-muted.with-alpha(0.65) :
                        cell.is-flagged                  ? p-yellow : p-muted.with-alpha(0.55);
                    
                    animate background { duration: 50ms; }

                    Text {
                        width: 100%; height: 100%;
                        horizontal-alignment: center; vertical-alignment: center;
                        font-size: min(parent.width, parent.height) * 0.55;
                        font-weight: 700;
                        
                        text:
                            cell.is-flagged && !cell.is-revealed ? "🚩" :
                            !cell.is-revealed                    ? "" :
                            cell.is-mine                         ? "💣" :
                            cell.neighbor-count > 0              ? cell.neighbor-count : "";
                        color: neighbor-color(cell.neighbor-count);
                    }

                    cell-ta := TouchArea {
                        width: 100%; height: 100%;
                        clicked => {
                            if game-state == GameState.Playing && !cell.is-revealed {
                                cell-clicked(cell-item.cell-col, cell-item.cell-row);
                            }
                        }
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down {
                                if e.button == PointerEventButton.left  { cell-item.left-down  = true; }
                                if e.button == PointerEventButton.right { cell-item.right-down = true; }
                            }
                            if e.kind == PointerEventKind.up {
                                if e.button == PointerEventButton.right && !cell-item.left-down && game-state == GameState.Playing && !cell.is-revealed {
                                    cell-flagged(cell-item.cell-col, cell-item.cell-row);
                                }
                                if cell-item.left-down && cell-item.right-down && cell.is-revealed && cell.neighbor-count > 0 && game-state == GameState.Playing {
                                    cell-chorded(cell-item.cell-col, cell-item.cell-row);
                                }
                                if e.button == PointerEventButton.left  { cell-item.left-down  = false; }
                                if e.button == PointerEventButton.right { cell-item.right-down = false; }
                            }
                        }
                    }
                }
            }
        }
    }
}